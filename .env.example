# Copia este archivo a .env y ajusta los valores (opcional).
# Sin .env funciona igual: usa los valores de config.yaml.

# Carpeta donde se guardan los libros (si existe, gana sobre config.yaml).
# DOWNLOAD_DIR=C:\Ruta\A\Tus\Libros

# Mirror de Anna's Archive a usar como principal (opcional).
# ANNAS_MIRROR=https://annas-archive.gl

# Idioma y formato por defecto para las búsquedas.
# DEFAULT_LANGUAGE=es
# DEFAULT_FORMAT=epub

# Modo del navegador: Chrome/Edge real con ventana (necesario para DDoS-Guard).
# No pongas HEADLESS=true o el challenge no se resuelve.
# HEADLESS=false

# Ruta al binario del navegador (opcional). Vacío = auto: Chrome y luego Edge.
# BROWSER_BINARY=C:\Program Files\Google\Chrome\Application\chrome.exe

# ── Integración con Calibre (opcional) ──────────────────────────────────────
# Ruta de la biblioteca de Calibre. Vacío = autodetectar.
# CALIBRE_LIBRARY=C:\Users\TU_USUARIO\Biblioteca de calibre

# Ruta a calibredb.exe. Vacío = autodetectar.
# CALIBRE_DB=C:\Program Files\Calibre2\calibredb.exe

# Importar automáticamente a Calibre cada descarga terminada (true/false).
# CALIBRE_AUTO_IMPORT=false

# Formato destino al enviar al dispositivo (mobi, azw3, epub, pdf).
# DEVICE_FORMAT=mobi

# Ruta manual del dispositivo (si no se autodetecta). Ej.: E:\documents
# DEVICE_PATH=